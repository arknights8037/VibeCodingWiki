{
  "name": "vibecodingwiki-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "build": "vue-tsc -b && vite build --config vite.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "predev": "node scripts/sync-editor.mjs",
    "prebuild": "node scripts/sync-editor.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.12.2",
    "dompurify": "^3.2.7",
    "element-plus": "^2.11.5",
    "marked": "^16.3.0",
    "pinia": "^3.0.3",
    "vditor": "^3.11.2",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.7.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
