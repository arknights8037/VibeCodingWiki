VCW_ENVIRONMENT=production
VCW_DATABASE_URL=sqlite+aiosqlite:////data/vibecodingwiki.db
VCW_DATA_DIR=/data
VCW_ACCESS_SECRET=replace-with-at-least-32-random-characters
VCW_ACCESS_TOKEN_MINUTES=30
VCW_REFRESH_TOKEN_DAYS=7
VCW_COOKIE_SECURE=false
VCW_HTTP_PORT=8088
VCW_ADMIN_EMAIL=admin@example.com
VCW_ADMIN_PASSWORD=replace-with-a-strong-password
VCW_ALLOWED_ORIGINS=["http://localhost","http://localhost:8088"]
